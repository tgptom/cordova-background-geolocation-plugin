{
  "name": "cordova-background-geolocation-plugin",
  "version": "2.3.5",
  "description": "Cordova Background Geolocation Plugin",
  "main": "./www/BackgroundGeolocation.js",
  "types": "./www/BackgroundGeolocation.d.ts",
  "cordova": {
    "id": "cordova-background-geolocation-plugin",
    "platforms": [
      "android",
      "ios"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgptom/cordova-background-geolocation-plugin.git"
  },
  "keywords": [
    "gps",
    "location",
    "geolocation",
    "background",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "cordova",
    "phonegap"
  ],
  "engines": {
    "cordovaDependencies": {
      "1.0.0": {
        "cordova": ">=8.0.0",
        "cordova-android": ">=12.0.0",
        "cordova-ios": ">=8.0.0"
      }
    }
  },
  "scripts": {
    "lint": "cd android && ./gradlew :common:lint :CDVBackgroundGeolocation:lint --no-daemon",
    "test:android": "cd android && ./gradlew :common:test :CDVBackgroundGeolocation:test :common:assembleDebug :CDVBackgroundGeolocation:assembleDebug --no-daemon",
    "test:ios": "xcodebuild test -project ios/common/BackgroundGeolocation.xcodeproj -target BackgroundGeolocationTests -destination 'platform=iOS Simulator,name=iPhone 15'",
    "pack:check": "npm pack --dry-run",
    "test": "npm run lint && npm run test:android && npm run test:ios && npm run pack:check"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tgptom/cordova-background-geolocation-plugin/issues"
  },
  "homepage": "https://github.com/tgptom/cordova-background-geolocation-plugin#readme"
}
